"#yamapper-notes-panel{position:fixed;right:0;bottom:0;left:0;z-index:2147483000;display:none;flex-direction:column;min-height:140px;background:var(--nmap-surface,#ffffff);border-top:1px solid var(--nmap-border-subtle,#e6e6e6);box-shadow:0 -6px 24px rgb(0 0 0 / 18%);}
#yamapper-notes-panel[data-open='true']{display:flex;}
#yamapper-notes-panel-handle{flex:0 0 auto;height:8px;margin-top:-4px;background:transparent;cursor:ns-resize;touch-action:none;}
#yamapper-notes-panel-handle::after{display:block;width:44px;height:4px;margin:2px auto 0;background:var(--nmap-text-muted,#999999);border-radius:2px;opacity:0.45;content:'';}
#yamapper-notes-panel-handle:hover::after,#yamapper-notes-panel-handle:focus-visible::after{opacity:0.8;}
#yamapper-notes-panel-frame{flex:1 1 auto;width:100%;min-height:0;border:0;background:var(--nmap-surface,#ffffff);}
#yamapper-notes-panel[data-layout='full'] #yamapper-notes-panel-handle{cursor:default;}
#yamapper-notes-panel[data-dragging='true'] #yamapper-notes-panel-frame{pointer-events:none;}
.yamapper-notes-edit-button-wrapper{position:fixed;bottom:18px;left:50%;z-index:3;display:flex;align-items:center;justify-content:center;transform:translateX(-50%);}
#yamapper-notes-edit-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:38px;padding:0 14px;margin:0;font-size:13px;line-height:38px;color:#fff;cursor:pointer;}
