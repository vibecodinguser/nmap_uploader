exports[`инжектируемые стили > object-tracker: текст не менялся 1`] = `
"#yamapper-object-tracker-panel,.nmap-ot-panel{display:flex;flex-direction:column;gap:12px;padding:12px;font-family:"Yandex Sans Text","YS Text",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:13px;line-height:1.35;color:inherit;text-align:left;background:transparent;box-sizing:border-box;width:100%;min-height:0;flex:1 1 auto;overflow:auto;overscroll-behavior:contain;}
#yamapper-object-tracker-panel *,.nmap-ot-panel *{box-sizing:border-box;}
#yamapper-object-tracker-panel:focus-visible,.nmap-ot-panel:focus-visible{outline:var(--nmap-focus-outline);outline-offset:1px;}
#yamapper-object-tracker-tab{cursor:pointer;user-select:none;white-space:nowrap;}
#yamapper-object-tracker-tab.nmap-ot-tab-unread::after{content:'';display:inline-block;width:6px;height:6px;margin-left:6px;border-radius:50%;background:var(--nmap-accent);vertical-align:middle;}
.nmap-ot-header{display:flex;flex-direction:column;gap:12px;}
.nmap-ot-title-row{display:flex;align-items:center;gap:12px;min-height:28px;}
.nmap-ot-title{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nmap-ot-warning{padding:8px 10px;border-radius:var(--nmap-radius-sm);background:#fff4c2;color:#6b4d00;line-height:1.4;}
.nmap-ot-add{display:flex;flex-direction:column;gap:6px;}
.nmap-ot-add__row{display:flex;align-items:center;gap:8px;}
.nmap-ot-add__field{flex:1 1 auto;min-width:0;border-radius:var(--nmap-radius-sm);overflow:hidden;}
.nmap-ot-add__field.nk-text-input_theme_islands::before{border-radius:var(--nmap-radius-sm);}
.nmap-ot-add__field .nk-text-input__control{border-radius:var(--nmap-radius-sm);background-color:transparent;}
.nmap-ot-add__field:focus-within{outline:var(--nmap-focus-outline);outline-offset:1px;}
.nmap-ot-add__submit{flex:0 0 auto;}
.nmap-ot-refresh.nk-icon{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;margin:0;padding:0;border:0;background:none;color:var(--nmap-text-muted);cursor:pointer;transition:color 0.15s ease;}
.nmap-ot-refresh.nk-icon > svg{display:block;margin:0;}
.nmap-ot-refresh.nk-icon:hover:not(:disabled),.nmap-ot-refresh.nk-icon:focus-visible{color:inherit;}
.nmap-ot-refresh.nk-icon:disabled{cursor:default;opacity:0.5;}
.nmap-ot-refresh_loading.nk-icon svg{animation:nmap-ot-spin 1s linear infinite;}
@keyframes nmap-ot-spin{to{transform:rotate(360deg);}
}
@media (prefers-reduced-motion:reduce){.nmap-ot-refresh_loading.nk-icon svg{animation:none;}
}
.nmap-ot-add__error{min-height:16px;color:var(--nmap-error);font-size:12px;line-height:16px;}
.nmap-ot-modes{position:relative;display:flex;margin:0 -12px;padding:0 12px;border-bottom:1px solid var(--border-color,var(--nmap-border-subtle));white-space:nowrap;}
.nmap-ot-modes .nmap-ot-mode{display:block;margin:0;padding:12px 8px;border:0;border-radius:0;background:none;color:var(--tabs-bar__bar--font-color,#666666);font:inherit;text-align:left;cursor:pointer;overflow:hidden;text-overflow:ellipsis;transition:color 0.3s ease;}
.nmap-ot-modes .nmap-ot-mode:hover,.nmap-ot-modes .nmap-ot-mode.nmap-ot-mode_active{color:var(--tabs-bar__bar_selected--font-color,#000000);}
.nmap-ot-modes .nmap-ot-mode.nmap-ot-mode_active{cursor:default;font-weight:inherit;}
.nmap-ot-modes .nmap-ot-modes__selection{background:var(--tabs-bar__selection--color,var(--nmap-accent));height:2px;left:0;margin-top:-2px;position:absolute;bottom:0;width:1px;display:block;transition:all 0.3s ease-out;}
.nmap-ot-body{display:flex;flex-direction:column;gap:8px;flex:1 1 auto;min-height:0;}
.nmap-ot-body_cards{margin:0 -12px;gap:0;}
.nmap-ot-body_cards .nk-event-view__event{padding-left:16px;padding-right:16px;}
.nmap-ot-empty{padding:8px 0 12px;color:var(--nmap-text-muted);text-align:left;}
.nmap-ot-body_cards .nmap-ot-empty{padding-left:16px;padding-right:16px;}
.nmap-ot-commit{position:relative;cursor:pointer;}
.nmap-ot-commit .nk-event-view__event{display:flex;}
.nmap-ot-commit .nk-event-view__title a{display:block;color:var(--nmap-link);text-decoration:none;}
.nmap-ot-commit .nk-event-view__title a:hover{text-decoration:underline;}
.nmap-ot-commit .nk-geoobject-preview-opener-view{cursor:pointer;}
.nmap-ot-new-dot{position:absolute;left:4px;top:18px;width:6px;height:6px;border-radius:50%;background:var(--nmap-accent);}
.nmap-ot-commit_new{background:rgba(255,219,77,0.1);}
.nmap-ot-object{position:relative;cursor:pointer;}
.nmap-ot-object .nk-event-view__event{display:flex;}
.nmap-ot-object .nk-event-view__title a{display:block;color:var(--nmap-link);text-decoration:none;}
.nmap-ot-object .nk-event-view__title a:hover{text-decoration:underline;}
.nmap-ot-object .nk-geoobject-preview-opener-view{cursor:pointer;}
.nmap-ot-object__remove{position:absolute;top:6px;right:6px;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;background:none;color:var(--nmap-text-muted);cursor:pointer;}
.nmap-ot-object__remove:hover,.nmap-ot-object__remove:focus-visible{color:var(--nmap-error);}
.nmap-ot-object .nmap-ot-object__content{padding-right:32px;}
.nmap-ot-object__error{color:var(--nmap-error);font-size:12px;padding:0 16px 8px;}
.nk-page_color-scheme_dark #yamapper-object-tracker-panel,.nk-page_color-scheme_dark .nmap-ot-panel{--control_theme_islands--bg-color:rgba(255,255,255,0.08);--control_theme_islands--border-color:rgba(255,255,255,0.3);--control_theme_islands--font-color:#ededed;--input_theme_islands__placeholder--font-color:var(--nmap-text-muted);}
