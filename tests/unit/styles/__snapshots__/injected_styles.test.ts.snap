.yamapper-split-banner--floating{position:fixed;top:22px;left:12px;z-index:2147483647 !important;}
.yamapper-split-banner--warning{background-color:rgba(220,38,38,0.85);box-shadow:0 3px 0 0 rgba(220,38,38,0.2);}"
