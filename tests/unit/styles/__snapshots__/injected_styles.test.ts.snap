.nmap-ot-menu-item_disabled{opacity:0.5;cursor:default;pointer-events:none;}
#yamapper-object-tracker-toast,.nmap-ot-toast{position:fixed;right:16px;bottom:16px;z-index:2147483000;max-width:320px;padding:10px 14px;border-radius:var(--nmap-radius-sm);background:rgba(32,33,36,0.92);color:#ffffff;font-family:"Yandex Sans Text","YS Text",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:13px;line-height:1.35;text-align:left;box-shadow:0 4px 16px rgba(0,0,0,0.24);pointer-events:none;opacity:0;transition:opacity 0.15s ease;}
.nmap-ot-toast_visible{opacity:1;}"
`;

