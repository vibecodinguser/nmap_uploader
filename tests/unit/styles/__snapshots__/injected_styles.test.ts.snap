exports[`инжектируемые стили > object-tracker: текст не менялся 1`] = `
"#nmap-uploader-object-tracker-panel,.nmap-ot-panel{display:flex;flex-direction:column;gap:12px;padding:12px;font-family:var(--nk-user-bar-font-family,"Yandex Sans Text","YS Text",-apple-system,BlinkMacSystemFont,Arial,sans-serif);font-size:13px;line-height:1.35;color:inherit;background:transparent;box-sizing:border-box;width:100%;min-height:0;flex:1 1 auto;overflow:auto;overscroll-behavior:contain;}
#nmap-uploader-object-tracker-panel *,.nmap-ot-panel *{box-sizing:border-box;}
#nmap-uploader-object-tracker-panel:focus-visible,.nmap-ot-panel:focus-visible{outline:2px solid #ffdb4d;outline-offset:1px;}
#nmap-uploader-object-tracker-tab{cursor:pointer;user-select:none;white-space:nowrap;}
#nmap-uploader-object-tracker-tab.nmap-ot-tab-unread::after{content:'';display:inline-block;width:6px;height:6px;margin-left:6px;border-radius:50%;background:#ffdb4d;vertical-align:middle;}
.nmap-ot-header{display:flex;flex-direction:column;gap:12px;}
.nmap-ot-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:28px;}
.nmap-ot-title{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nmap-ot-warning{padding:8px 10px;border-radius:4px;background:#fff4c2;color:#6b4d00;line-height:1.4;}
.nmap-ot-add{display:flex;flex-direction:column;gap:6px;}
.nmap-ot-add__label{color:#999999;font-size:12px;}
.nmap-ot-add__row{display:flex;align-items:center;gap:8px;}
.nmap-ot-add__field{flex:1 1 auto;min-width:0;border-radius:4px;overflow:hidden;}
.nmap-ot-add__field.nk-text-input_theme_islands::before{border-radius:4px;}
.nmap-ot-add__field .nk-text-input__control{border-radius:4px;background-color:transparent;}
.nmap-ot-add__field:focus-within{outline:2px solid #ffdb4d;outline-offset:1px;}
.nmap-ot-add__submit{flex:0 0 auto;}
.nmap-ot-add__error{min-height:16px;color:#e00000;font-size:12px;line-height:16px;}
.nmap-ot-modes{position:relative;display:flex;margin:0 -12px;padding:0 12px;border-bottom:1px solid var(--border-color,#e6e6e6);white-space:nowrap;}
.nmap-ot-modes .nmap-ot-mode{display:block;margin:0;padding:12px 8px;border:0;border-radius:0;background:none;color:var(--tabs-bar__bar--font-color,#666666);font:inherit;text-align:left;cursor:pointer;overflow:hidden;text-overflow:ellipsis;transition:color 0.3s ease;}
.nmap-ot-modes .nmap-ot-mode:hover,.nmap-ot-modes .nmap-ot-mode.nmap-ot-mode_active{color:var(--tabs-bar__bar_selected--font-color,#000000);}
.nmap-ot-modes .nmap-ot-mode.nmap-ot-mode_active{cursor:default;font-weight:inherit;}
.nmap-ot-modes .nmap-ot-modes__selection{background:var(--tabs-bar__selection--color,#ffdb4d);height:2px;left:0;margin-top:-2px;position:absolute;bottom:0;width:1px;display:block;transition:all 0.3s ease-out;}
.nmap-ot-body{display:flex;flex-direction:column;gap:8px;flex:1 1 auto;min-height:0;}
.nmap-ot-body_feed{margin:0 -12px;gap:0;}
.nmap-ot-body_feed .nmap-ot-commit .nk-event-view__event{padding-left:16px;padding-right:16px;}
.nmap-ot-empty{padding:8px 0 12px;color:#999999;}
.nmap-ot-commit{position:relative;cursor:pointer;}
.nmap-ot-commit .nk-event-view__event{display:flex;}
.nmap-ot-commit .nk-event-view__title a{display:block;color:#0055cc;text-decoration:none;}
.nmap-ot-commit .nk-event-view__title a:hover{text-decoration:underline;}
.nmap-ot-commit .nk-geoobject-preview-opener-view{cursor:pointer;}
.nmap-ot-new-dot{position:absolute;left:4px;top:18px;width:6px;height:6px;border-radius:50%;background:#ffdb4d;}
.nmap-ot-commit_new{background:rgba(255,219,77,0.1);}
.nmap-ot-object{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;border:1px solid var(--border-color,#e6e6e6);border-radius:4px;padding:8px 10px;}
.nmap-ot-object__info{min-width:0;flex:1 1 auto;}
.nmap-ot-object__title{color:#0055cc;text-decoration:none;font-weight:500;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nmap-ot-object__title:hover{text-decoration:underline;}
.nmap-ot-object__meta{color:#999999;font-size:12px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;}
.nmap-ot-object__remove{flex:0 0 auto;}
.nmap-ot-object__error{color:#e00000;font-size:12px;margin:-4px 0 4px;}
.nk-page_color-scheme_dark #nmap-uploader-object-tracker-panel,.nk-page_color-scheme_dark .nmap-ot-panel{--control_theme_islands--bg-color:rgba(255,255,255,0.08);--control_theme_islands--border-color:rgba(255,255,255,0.3);--control_theme_islands--font-color:#ededed;--input_theme_islands__placeholder--font-color:#999999;}
.nk-page_color-scheme_dark .nmap-ot-add__submit.nk-button_theme_islands.nk-button_view_action{--control_theme_islands--font-color:#000000;}
.nk-page_color-scheme_dark .nmap-ot-empty,.nk-page_color-scheme_dark .nmap-ot-object__meta,.nk-page_color-scheme_dark .nmap-ot-add__label{color:#999999;}
.nk-page_color-scheme_dark .nmap-ot-object__title,.nk-page_color-scheme_dark .nmap-ot-commit .nk-event-view__title a{color:#8ab4ff;}
.nk-page_color-scheme_dark .nmap-ot-object{border-color:rgba(255,255,255,0.18);}
.nk-page_color-scheme_dark .nmap-ot-commit_new{background:rgba(255,219,77,0.1);}
.nk-page_color-scheme_dark .nmap-ot-warning{background:rgba(255,219,77,0.16);color:#ffd76e;}
.nk-page_color-scheme_dark .nmap-ot-add__error,.nk-page_color-scheme_dark .nmap-ot-object__error{color:#ff8080;}
.nk-page_color-scheme_dark .nmap-ot-modes{border-bottom-color:rgba(255,255,255,0.18);}
.nk-page_color-scheme_dark .nmap-ot-modes .nmap-ot-mode{color:#999999;}
.nk-page_color-scheme_dark .nmap-ot-modes .nmap-ot-mode:hover,.nk-page_color-scheme_dark .nmap-ot-modes .nmap-ot-mode.nmap-ot-mode_active{color:#ffffff;}
@media (prefers-color-scheme:dark){.nk-page:not(.nk-page_color-scheme_light) .nmap-ot-commit__object,.nk-page:not(.nk-page_color-scheme_light) .nmap-ot-object__title{color:#8ab4ff;}
}"
`;

exports[`инжектируемые стили > stroke-recolor: текст не менялся 1`] = `"ymaps svg [stroke="#ff00ff" i],ymaps svg [stroke="#f0f" i],ymaps svg [stroke="magenta" i],ymaps svg [stroke="rgb(255,0,255)" i],ymaps svg [stroke="rgba(255,0,255,1)" i],.nk-app-view svg [stroke="#ff00ff" i],.nk-app-view svg [stroke="#f0f" i],.nk-app-view svg [stroke="magenta" i],.nk-app-view svg [stroke="rgb(255,0,255)" i],svg [stroke="#ff00ff" i],svg [stroke="#f0f" i],svg [stroke="magenta" i],svg [stroke="rgb(255,0,255)" i]{stroke:#00ff00 !important;}"`;
