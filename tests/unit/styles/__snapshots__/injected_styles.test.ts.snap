.yamapper-split{position:fixed;top:0;right:0;width:50vw;height:100vh;z-index:2147483640;box-sizing:border-box;border-left:2px solid rgba(0,0,0,0.25);background:#fff;}
.yamapper-split__iframe-wrap{position:relative;width:100%;height:100%;}
.yamapper-split__iframe{width:100%;height:100%;border:none;display:block;}
.yamapper-split__cursor-overlay,.yamapper-split__left-cursor-overlay{position:fixed;top:0;left:0;overflow:hidden;pointer-events:none;z-index:2147483641;}
.yamapper-split__cursor-overlay{right:0;left:50vw;width:50vw;height:100vh;}
.yamapper-split__left-cursor-overlay{width:50vw;height:100vh;}
.yamapper-split__cursor-marker{position:absolute;top:0;left:0;width:6px;height:6px;border:none;border-radius:50%;background:#ff3b30;box-shadow:0 0 0 2px #fff,0 0 0 4px #ff3b30;opacity:0;visibility:hidden;transform:translate(-50%,-50%);pointer-events:none;}
.yamapper-split__cursor-marker--visible{opacity:1;visibility:visible;}
html.yamapper-split-active .nk-search-view:has(> .yamapper-split-banner),html.yamapper-split-active .nk-search-view:has(> .yamapper-split-banner){display:flex;align-items:center;gap:8px;min-width:0;}
