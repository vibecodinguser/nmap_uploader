#nmap-uploader-object-tracker-panel:focus-visible,.nmap-ot-panel:focus-visible{outline:var(--nmap-focus-outline);outline-offset:1px;}
#nmap-uploader-object-tracker-tab{cursor:pointer;user-select:none;white-space:nowrap;}
#nmap-uploader-object-tracker-tab.nmap-ot-tab-unread::after{content:'';display:inline-block;width:6px;height:6px;margin-left:6px;border-radius:50%;background:var(--nmap-accent);vertical-align:middle;}
.nmap-ot-header{display:flex;flex-direction:column;gap:12px;}
.nmap-ot-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:28px;}
.nmap-ot-title{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nmap-ot-warning{padding:8px 10px;border-radius:var(--nmap-radius-sm);background:#fff4c2;color:#6b4d00;line-height:1.4;}
.nmap-ot-add{display:flex;flex-direction:column;gap:6px;}
.nmap-ot-add__label{color:var(--nmap-text-muted);font-size:12px;}
.nmap-ot-add__row{display:flex;align-items:center;gap:8px;}
.nmap-ot-add__field{flex:1 1 auto;min-width:0;border-radius:var(--nmap-radius-sm);overflow:hidden;}
