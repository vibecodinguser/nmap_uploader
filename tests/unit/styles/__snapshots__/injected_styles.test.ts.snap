#yamapper-notes-edit-button:focus-visible::before{box-shadow:0 0 0 2px #ffdb4d;}
.yamapper-notes-edit-button__icon{position:relative;display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;color:#fff;opacity:0.65;transition:opacity 0.2s ease-in-out;}
