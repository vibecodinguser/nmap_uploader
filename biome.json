{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!**/.output", "!!**/.wxt", "!!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": [
        "entrypoints/panel/App.tsx",
        "entrypoints/panel/main.tsx",
        "entrypoints/panel-sidebar.content.tsx",
        "entrypoints/map-go-to.content.ts",
        "entrypoints/map-stroke-recolor.content.ts",
        "entrypoints/map-stroke-recolor-main.content.ts",
        "entrypoints/nakarte-sync.content.ts",
        "entrypoints/nakarte-sync-main.content.ts",
        "entrypoints/nmaps-location-main.content.ts",
        "lib/browser.ts",
        "lib/converters/geojson.ts",
        "lib/converters/index.ts",
        "lib/go_to_geo_projection.ts",
        "lib/go_to_theme.ts",
        "lib/geojson/geojson_spec.ts",
        "lib/gpx/gpx_spec.ts",
        "lib/kml/kml_spec.ts",
        "lib/shapefile/esri_spec.ts",
        "lib/topojson/topojson_spec.ts",
        "hooks/useAuth.ts",
        "hooks/useFileUpload.ts",
        "hooks/usePointUpload.ts",
        "hooks/useGoToLinks.ts",
        "hooks/useLocale.tsx",
        "hooks/useReloadAfterUpload.ts",
        "hooks/useStrokeColor.ts",
        "hooks/useTheme.ts",
        "components/GoToLinksSettings.tsx",
        "components/GoToLinksSettingsItem.tsx",
        "components/PointDateField.tsx",
        "components/PointsTab.tsx",
        "components/ManualTab.tsx",
        "components/BatchTab.tsx",
        "components/PoligonTab.tsx",
        "components/MultipointUpload.tsx",
        "components/ManualPointUpload.tsx",
        "components/SettingsTab.tsx",
        "components/TabBar.tsx",
        "components/TabButton.tsx",
        "components/UploadStatusMessage.tsx",
        "components/UploadProgressRing.tsx",
        "tests/setup/a11y.tsx",
        "tests/setup/browser_mock.ts",
        "tests/setup/content_script_context.ts",
        "tests/setup/vitest.setup.ts",
        "tests/setup/yandex_handlers.ts",
        "tests/integration/upload_service.test.ts",
        "tests/integration/yandex_disk.test.ts",
        "tests/integration/yandex_oauth.test.ts",
        "wxt.config.ts",
        "stylelint.config.js",
        "lib/i18n/upload_auth_logs.js",
        "lib/i18n/upload_complete.js",
        "lib/i18n/translate.js",
        "lib/i18n/locale_storage.js",
        "lib/i18n/locale_state.js",
        "lib/i18n/locale.js",
        "env.d.ts"
      ],
      "javascript": {
        "formatter": {
          "semicolons": "always"
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
