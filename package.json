{
  "name": "Загрузчик в Блокнот картографа Народной карты",
  "description": "Загрузка геоданных в Блокнот картографа НЯК",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "compile:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:a11y": "vitest run tests/unit/a11y",
    "docs:dev": "pnpm --dir docs-site dev",
    "docs:build": "pnpm --dir docs-site build",
    "docs:publish": "docs-site/scripts/publish-gh-pages.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:css": "stylelint \"assets/styles/**/*.css\" \"lib/**/*.css\"",
    "lint:css:fix": "stylelint \"assets/styles/**/*.css\" \"lib/**/*.css\" --fix",
    "check": "npm run lint && npm run lint:css && npm run compile && npm run test:run",
    "release": "pnpm release:fix && pnpm release:check && pnpm release:zip",
    "release:fix": "biome check --write . && stylelint \"assets/styles/**/*.css\" \"lib/**/*.css\" --fix",
    "release:check": "pnpm compile && pnpm compile:tests && pnpm lint && pnpm lint:css && pnpm test:run",
    "release:zip": "find .output -name '*.zip' -type f -delete 2>/dev/null; pnpm zip && pnpm zip:firefox",
    "format": "biome format --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.575.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shpjs": "^6.2.0",
    "topojson-client": "^3.1.0",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-specification": "^1.0.5",
    "@types/wellknown": "^0.5.8",
    "@webext-core/fake-browser": "^1.5.2",
    "@wxt-dev/module-react": "^1.2.2",
    "@xmldom/xmldom": "^0.9.12",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "msw": "^2.15.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0",
    "wxt": "^0.20.27"
  }
}
