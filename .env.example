# OAuth client_id Яндекс ID (опционально; без значения используется встроенный по умолчанию)
YANDEX_CLIENT_ID=

# Redirect URI для dev (опционально; иначе browser.identity.getRedirectURL())
# Firefox с gecko.id nmap-uploader@local.dev:
# https://nmap-uploader_local.dev.extensions.allizom.org/
YANDEX_REDIRECT_URI=

# Публичный ключ CRX для стабильного extension id в Chrome dev (опционально)
CHROME_EXTENSION_KEY=

# Путь к исполняемому файлу Yandex Browser для `pnpm dev`
YANDEX_BROWSER_BINARY=/Applications/Yandex.app/Contents/MacOS/Yandex

# OAuth-токен для smoke-тестов против live API (`pnpm test:smoke`)
YANDEX_TEST_TOKEN=
