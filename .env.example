# OAuth client_id Яндекс ID (опционально; без значения используется встроенный по умолчанию)
YANDEX_CLIENT_ID=

# Redirect URI для dev — зарегистрируйте в oauth.yandex.ru (должен совпадать с getRedirectURL())
# Chrome (CHROME_EXTENSION_KEY): https://pfmakliblbchbbjplplmkdhgbofmamdm.chromiumapp.org/
# Firefox (pnpm dev:firefox): https://4a5e412e7f9b878927b1bedbfad1a6905cb32415.extensions.allizom.org/
YANDEX_REDIRECT_URI=

# Публичный ключ CRX для стабильного extension id только в `pnpm dev` (опционально).
# Не попадает в production ZIP — для Chrome Web Store key в manifest не нужен.
CHROME_EXTENSION_KEY=

# Путь к исполняемому файлу Yandex Browser для `pnpm dev`
YANDEX_BROWSER_BINARY=/Applications/Yandex.app/Contents/MacOS/Yandex

# OAuth-токен для smoke-тестов против live API (`pnpm test:smoke`)
YANDEX_TEST_TOKEN=
